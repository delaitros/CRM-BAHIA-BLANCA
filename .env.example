# ============================================================
# Lo de Juan - CRM Bahía Blanca
# Copiar este archivo a .env y completar los valores
# cp .env.example .env
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=CAMBIAR_password_seguro_aqui

# ── Chatwoot ────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=CAMBIAR_generar_con_openssl_rand_hex_64
CHATWOOT_URL=http://localhost:3000
CHATWOOT_PORT=3000

# Chatwoot API (obtener desde Chatwoot > Settings > Account > API)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1

# ── Facebook / Instagram / WhatsApp ────────────────────────
# Configurar en Meta Business Suite > Developers
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=

# ── Agente IA (Claude / Anthropic) ──────────────────────────
# Obtener en: https://console.anthropic.com/  (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Afecta calidad y costo. Opciones (de mas a menos potente):
#   claude-opus-4-7    -> maxima calidad   (mas caro)
#   claude-sonnet-4-6  -> equilibrado      (recomendado para volumen)
#   claude-haiku-4-5   -> rapido y barato  (tareas simples)
ANTHROPIC_MODEL=claude-opus-4-7

# ── MercadoPago (cobro de sena para cerrar la venta) ────────
# Obtener en: https://www.mercadopago.com.ar/developers > Tus integraciones
# > Credenciales de produccion > Access Token
MERCADOPAGO_ACCESS_TOKEN=

# URL publica del sistema (con https). Necesaria para que MercadoPago
# avise los pagos. En local usar la URL de ngrok. Ej: https://midominio.com
PUBLIC_URL=

# ── Google Calendar (disponibilidad) ─────────────────────────
# URL secreta en formato iCal de tu Google Calendar.
# Ir a Google Calendar > Configuracion del calendario > Direccion secreta en formato iCal
# El bot y la landing usan esto para saber que fechas estan ocupadas.
GOOGLE_CALENDAR_ICS_URL=

# Milisegundos que espera el agente juntando mensajes seguidos del cliente
# antes de responder (para no pisar ni ignorar mensajes). Default 60000 ms (1 minuto).
# Si el cliente manda 3 mensajes en 1 minuto, el bot espera a leer los 3 y responde una sola vez.
DEBOUNCE_MS=60000

# ── Email (SMTP - opcional) ─────────────────────────────────
MAILER_SENDER_EMAIL=noreply@lodejuan.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# ── Web ─────────────────────────────────────────────────────
WEB_PORT=80
